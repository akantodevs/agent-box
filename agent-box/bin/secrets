#!/usr/bin/env bash
# Access an environment's infrastructure secrets (SOPS + age). Baked into agent-box at /usr/local/bin.
#
#   secrets <env> edit                    edit secrets.enc.env in $EDITOR
#   secrets <env> exec -- <cmd> [args…]   run <cmd> with the secrets in its environment
#   secrets <env> updatekeys              re-encrypt to the recipients in .sops-infra.yaml
#
# <env> is a directory /workspace/infrastructure/<env> holding .sops-infra.yaml (the sops config) and
# secrets.enc.env (dotenv, encrypted). The age key comes from SOPS_AGE_KEY / SOPS_AGE_KEY_FILE.
#
# Run Terraform as `tf` (see tf) or `secrets <env> exec -- terraform -chdir=<dir> <args>`: agent-box's
# terraform-guard recognises both forms, so don't hide terraform behind another wrapper name.
set -euo pipefail

# AGENT_BOX_INFRA_DIR exists for the tests; deployments keep their infrastructure here.
infra_dir="${AGENT_BOX_INFRA_DIR:-/workspace/infrastructure}"

environments() {
    local config names=()
    for config in "$infra_dir"/*/.sops-infra.yaml; do
        [[ -e "$config" ]] && names+=("$(basename "$(dirname "$config")")")
    done
    echo "${names[*]:-none (no $infra_dir/<env>/.sops-infra.yaml)}"
}

usage() {
    local me
    me="$(basename "$0")"
    {
        echo "usage: $me <env> edit"
        echo "       $me <env> exec -- <command> [args...]"
        echo "       $me <env> updatekeys"
        echo "environments: $(environments)"
    } >&2
    exit 2
}

[[ $# -ge 2 ]] || usage
env="$1"
action="$2"
shift 2

config="$infra_dir/$env/.sops-infra.yaml"
file="$infra_dir/$env/secrets.enc.env"

# An environment is a direct child of infra_dir with a sops config; no paths, no dot-dirs.
if [[ -z "$env" || "$env" == */* || "$env" == .* || ! -f "$config" ]]; then
    echo "unknown environment: $env" >&2
    usage
fi

case "$action" in
    edit)
        [[ $# -eq 0 ]] || usage
        exec sops --config "$config" edit "$file"
        ;;
    exec)
        [[ "${1:-}" == "--" ]] && shift
        [[ $# -ge 1 ]] || usage
        # sops exec-env runs one /bin/sh command string: single-quote every argument (POSIX-safe for any byte).
        command=""
        for arg in "$@"; do
            command+="'${arg//\'/\'\\\'\'}' "
        done
        exec sops --config "$config" exec-env "$file" "$command"
        ;;
    updatekeys)
        [[ $# -eq 0 ]] || usage
        exec sops --config "$config" updatekeys --yes "$file"
        ;;
    *)
        echo "unknown action: $action" >&2
        usage
        ;;
esac
